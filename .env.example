# Порт Fastify (в проде задаётся платформой)
PORT=3000

# Строка подключения PostgreSQL (Neon). Если не задана — используется PGlite (тесты/локальный dev).
# Формат: postgresql://user:password@host/db?sslmode=require
#
# SSL-режим в этой строке можно не трогать: сервер сам приводит его к
# verify-full (server/env.ts, normalizeSslMode), потому что и Neon, и Render
# формируют ссылку сами и по умолчанию кладут sslmode=require, на который
# pg-connection-string ругается предупреждением.
DATABASE_URL=

# Пароль для Basic-auth на /dashboard и /admin/* (доступ организатора и наставника).
# Если не задан — панель открыта. В продакшене задавать обязательно.
# Демо-значение из README: call-calendar-admin
ADMIN_PASSWORD=

# ── Cloudflare Turnstile (ADR-0025) ──────────────────────────────────────
# CAPTCHA включена, когда задан TURNSTILE_SECRET_KEY. Если он пуст — виджет
# не показывается и сервер не проверяет токен (удобно для dev и CI).
# Настройка виджета: https://dash.cloudflare.com → Turnstile → Create a widget
#   Widget mode: Managed, Appearance: Visible, Pre-clearance: Off.
# На бесплатном плане 10 хостов на виджет; локально добавьте localhost.
#
# В продакшене задать в Render (Environment), НЕ в этом файле — он в git.
# Локально удобно использовать официальные тестовые ключи (не тратят лимиты):
#   TURNSTILE_SITEKEY=1x00000000000000000000AA          # always pass
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  # always pass
TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=

# Домены через запятую, которым разрешено использовать site key.
# Пусто — сверка hostname выключена. В Render: calendar-slots-app.onrender.com
TURNSTILE_ALLOWED_HOSTNAMES=
