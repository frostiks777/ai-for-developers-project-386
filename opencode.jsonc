{
  "$schema": "https://opencode.ai/config.json",

  // Главная модель для основного агента — можно использовать любую доступную
  "model": "opencode/mimo-v2.5-free",

  // КРИТИЧНО: все встроенные субагенты обязаны использовать ТОЛЬКО бесплатные модели.
  // Это дефолтная модель; при запуске через subagent tool модель НЕ ДОЛЖНА
  // переопределяться на платную — см. docs/model-usage.md и AGENTS.md.
  "agents": {
    "explore": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "general": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    }
  }
}
